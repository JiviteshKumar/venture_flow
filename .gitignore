# Secrets and local configuration
.env
.env.*
!.env.example

# Python environments, caches, and generated files
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.checkpoints/

# JavaScript dependencies and build output
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
*.tsbuildinfo

# Local tooling and operating-system files
.vscode/
.DS_Store
*.log

# Downloaded/training datasets and local reports
data/
# ml/data/outcome_dataset.jsonl is a RUNTIME dependency, not a build artefact:
# comparables.py reads it on every analysis to find comparable companies, so a
# fresh clone without it silently reports comparables as unavailable. Git will
# not re-include a file whose parent directory is excluded, hence unexcluding
# ml/data/ first and then re-excluding its contents. The 10 MB raw yc-oss dump
# and the derived training set stay out: both are only needed to retrain, and
# ml/README.md documents the one-command refresh from the public source.
!ml/data/
ml/data/*
!ml/data/outcome_dataset.jsonl
TAT-QA/
due_diligence_report.json
AGENT_LOG.md
VALIDATION_LOG.md

# Preserved metadata from the formerly nested frontend repository
.frontend-git-backup/

# Runtime score logs (drift-check input) -- not source, don't commit
ml/logs/*.jsonl
ml/models/personalization_model.pkl
ml/models/personalization_model_report.json

# Claim and Risk/Tone model artefacts. Both were trained successfully (see
# ml/README.md for their actual metrics) but NEITHER is wired into the app --
# the Claim Model because it is not good enough to ship, the Risk model
# because swapping it against the incumbent keyword detector needs its own
# evaluation first. Together they are ~73 MB of encoders for code paths
# nothing calls, and both regenerate in about a minute:
#   python ml/scripts/train_claim_model.py
#   python ml/scripts/train_risk_model.py
# The .json reports ARE committed, so the measured results stay in the repo
# even though the weights don't.
ml/models/claim_model.txt
ml/models/claim_model_encoders.pkl
ml/models/risk_tone_model.txt
ml/models/risk_tone_model_encoders.pkl

# Downloaded training corpus cache (re-fetched automatically when missing)
ml/data/scifact_data.tar.gz

# Build output. `frontend/.gitignore` used to cover the frontend half; it was a
# zero-byte file and was removed with the rest of the empty scaffolding, so the
# root list has to be complete on its own.
dist/
frontend/dist/
build/

# The hindsight-feature variant of the Outcome Model. Trained by
# ml/scripts/train_outcome_model.py purely so the leakage ablation in
# ml/models/outcome_model_report.json can be reproduced; nothing loads it and
# it regenerates with the shipped model in one command. Same treatment as the
# other unshipped weights above -- the measured numbers are committed, the
# bytes are not.
ml/models/outcome_model_combined_hindsight.txt

# Local run logs from the eval harnesses (also covered by *.log, listed
# explicitly because the directory is easy to add to by accident).
.runlogs/

# Per-excerpt LLM judgement cache for ml/scripts/eval_risk_detector.py. Lets an
# interrupted run resume instead of re-paying for excerpts already scored --
# it is a resume aid, not a result. The results file is the artifact.
ml/eval/*.llm_cache.jsonl

# Scraped third-party pitch decks (ml/eval/decks/*.pdf).
#
# The MANIFEST is committed and the PDFs are not, deliberately. Two reasons:
# 19MB of binaries would live in git history forever, and these are other
# companies' copyrighted decks retrieved from public mirrors -- redistributing
# them through this repository is not ours to do.
#
# The corpus stays reproducible without them: manifest.json records the source
# URL, SHA-256, byte size, extracted character count and deck vintage of every
# file, and `python scripts/scrape_pitch_decks.py` re-fetches them. A SHA-256
# mismatch on re-fetch means the mirror changed the file, which is worth
# knowing rather than papering over.
ml/eval/decks/*.pdf

# Arm-specific risk model binaries. The SHIPPED model
# (ml/models/risk_disclosure_model.pkl) is committed; the text-only and
# deck-feature variants are ~3.5MB each and are exactly reproducible:
#   python ml/scripts/train_risk_disclosure_model.py --out-suffix _textonly
#   python ml/scripts/train_risk_disclosure_model.py --deck-features --out-suffix _deckfeat
# Their REPORTS are committed, because those carry the before/after numbers and
# the leakage audit, which is what the comparison actually needs.
ml/models/risk_disclosure_model_textonly.pkl
ml/models/risk_disclosure_model_deckfeat.pkl
