# Copy this file to .env for local development and provide these values in your backend host.
# All persistence is Neon Postgres -- no Supabase. (The old Supabase ingestion
# pipeline is quarantined in legacy/supabase_ingestion/ and not wired in.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GROQ_API_KEY=your_groq_api_key
# Both spellings: a browser treats localhost and 127.0.0.1 as different
# origins, and Vite serves on both. Listing only one makes the UI load and
# then silently never populate.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Regex of ADDITIONAL allowed origins, for hosts whose name is not
# fixed. Vercel mints a new hostname per project and per preview deployment, so
# an exact-match ALLOWED_ORIGINS list silently breaks whenever a new one
# appears -- and the symptom is a bare "Network Error" in the browser while the
# server logs a healthy 200. Keep it ANCHORED; a bare .*vercel\.app would let
# any Vercel site call this unauthenticated API and spend your Groq quota.
# ALLOWED_ORIGIN_REGEX=^https://venture-flow-[a-z0-9-]+\.vercel\.app$

# Optional. Set to true when running behind a managed platform's load balancer
# (Render, Fly) so rate limiting keys on the real client via X-Forwarded-For
# rather than the proxy. Leave unset if the app is directly internet-facing --
# the header is client-supplied and spoofable.
# TRUST_PROXY_HEADERS=true
RATE_LIMIT_PER_MINUTE=30

# Shared passphrase gating a deployed demo. UNSET = OPEN, which is right for
# local development and wrong for anything reachable from the internet: without
# it, every stored report is readable by any anonymous caller over sequential
# integer ids (/reports/50). This is a gate, not authentication -- there is no
# user model and no per-account isolation, so everyone holding the passphrase
# sees the same shared pool of reports. Set it on any deployment.
# DEMO_ACCESS_TOKEN=choose-a-long-random-passphrase

# ── Web search ──────────────────────────────────────────────────────────────
# Search runs through a provider chain (agents/web_search.py) rather than one
# backend, because a single throttled provider used to take every claim check,
# founder lookup and adverse-news search down at the same moment.
#
# DuckDuckGo and Wikipedia need NO key and are always active, so the chain
# works on a fresh clone with nothing set here. The two below are optional
# extra links in that chain and are skipped entirely when unset.
# BRAVE_SEARCH_API_KEY=      # free tier: 2,000 queries/month
# TAVILY_API_KEY=            # free tier: 1,000 credits/month
#
# Seconds a provider is skipped after it fails, so a rate-limited provider is
# not re-tried (at the cost of its own timeout) on every subsequent query.
# VENTUREFLOW_SEARCH_COOLDOWN=120

# ── OCR for image-only decks (ocr_extractor.py) ─────────────────────────────
# Runs offline with no key and no per-page cost; the model weights ship inside
# the rapidocr-onnxruntime wheel. Set to "off" to restore the old behaviour, in
# which a deck whose pages are pictures is refused -- useful for isolating
# whether a bad extraction came from OCR or from the text layer.
# VENTUREFLOW_OCR=off
#
# Wall-clock ceiling for one document, and a hard page cap on top of it. OCR
# runs inside the upload request; when the budget runs out the read stops and
# reports how many pages it managed, rather than timing the request out.
# VENTUREFLOW_OCR_TIME_BUDGET=120
# VENTUREFLOW_OCR_MAX_PAGES=40

# ── Tech-startup scope gate (tech_scope.py) ─────────────────────────────────
# VentureFlow's scoring model is trained on technology companies, so a score
# for a business outside that scope has no calibrated meaning and both
# /upload-pdf and /analyze refuse one. Set to "off" to disable the refusal --
# every deck is then analysed, including ones the model has no basis for.
# VENTUREFLOW_TECH_SCOPE_GATE=off

# ── Founder research (agents/founder_research.py) ───────────────────────────
# Set to "off" to stop the pipeline reaching the open web for founder names.
# VENTUREFLOW_FOUNDER_RESEARCH=off

# Optional -- only used if set (see rate_limiter.py / technical_scoring.py).
# REDIS_URL=redis://localhost:6379/0
# GITHUB_TOKEN=

# Only read by the deployed frontend (Vercel). Local `npm run dev` reads
# frontend/.env instead, which points at 127.0.0.1:8000 on purpose -- see the
# comment there. This value is ignored locally; changing it will not affect
# a local run.
VITE_API_BASE_URL=http://localhost:8000
