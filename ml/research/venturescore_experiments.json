{
  "dataset": {
    "n": 1560,
    "n_positive": 726,
    "n_negative": 834,
    "base_rate": 0.4654,
    "source": "yc-oss/api snapshot, 3.5y+ post-launch, resolved outcome only"
  },
  "protocol": {
    "cv": "RepeatedStratifiedKFold(n_splits=5, n_repeats=3)",
    "bootstrap_samples": 2000,
    "transformers_fit": "inside training fold only"
  },
  "leakage_control": {
    "excluded_from_production_model": [
      "team_size",
      "age_years",
      "batch_year"
    ],
    "rationale": "team_size records headcount at snapshot time (exited median 11 / mean 105 vs shut-down median 3 / mean 10), which reflects post-outcome growth rather than a seed-stage signal; age_years and batch_year encode right-censoring, with cohort exit rate falling from ~0.65 (2010) to ~0.38 (2021-22).",
    "also_excluded_at_dataset_level": [
      "isHiring",
      "top_company",
      "website_liveness"
    ]
  },
  "production_model": {
    "family": "rf",
    "feature_set": "deployable (post-outcome features removed)",
    "calibration": "isotonic"
  },
